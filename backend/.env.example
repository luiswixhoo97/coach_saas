APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# En producción usar la URL donde está public/ (incluir /backend/public si aplica), ej:
# APP_URL=https://palegoldenrod-scorpion-430177.hostingersite.com/backend/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Si el frontend llama desde otro origen (ej. localhost o otro dominio), evita 419 con:
SESSION_SAME_SITE=none
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase (FCM). No subas el JSON de credenciales a Git.
# Copia firebase-credentials.example.json a storage/app/firebase-credentials.json
# y rellena con tu cuenta de servicio, o define la ruta absoluta aquí:
# FIREBASE_CREDENTIALS=

# CORS y Sanctum: obligatorio si el frontend está en otro origen (evita 419 en login).
# Orígenes permitidos (el que abre la app en el navegador). Varios separados por coma.
# Incluir: local (3000), APK (https://localhost), y producción.
# La APK (Capacitor) envía origen https://localhost o http://localhost.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost,http://localhost,https://palegoldenrod-scorpion-430177.hostingersite.com
# Dominios stateful (host del frontend, sin protocolo). Mismos que arriba sin http(s)://
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,palegoldenrod-scorpion-430177.hostingersite.com
